# 复制成 .env 后填写。不要把真实值提交到仓库。

# 后台登录密码。留空则整个后台停用（前台照常工作）。
ADMIN_PASSWORD=

# 登录态签名密钥。任意长随机串；变更后所有人需要重新登录。
# 本地可以用：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Postgres 连接串。在 Render 上由平台注入，本地开发才需要手填。
# 留空时：后台停用，前台使用页面内置内容，不会报错。
DATABASE_URL=

# 生产环境请设为 production（会隐藏详细错误、并要求 Cookie 走 HTTPS）
NODE_ENV=development
